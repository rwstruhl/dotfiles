[pull]
	rebase = false
[user]
	email = ryan@rally.space
	name = Ryan Struhl
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOz9UGdgOEbQhEcKIAIO+5mQEwKTdXpxeee8MBSFSxR2
[commit]
	gpgsign = true
[diff]
	tool = Kaleidoscope
[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
	trustExitCode = true
[merge]
	tool = Kaleidoscope
[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true
[mergetool]
	prompt = false
[credential]
	helper = osxkeychain
[maintenance]
  auto = false
  strategy = incremental
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
